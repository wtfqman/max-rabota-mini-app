  id             String          @id @default(cuid())
  reportId       String          @map("report_id")
  moderatorId    String?         @map("moderator_id")
  action         String
  statusFrom     AdReportStatus? @map("status_from")
  statusTo       AdReportStatus  @map("status_to")
  adStatusFrom   AdStatus?       @map("ad_status_from")
  adStatusTo     AdStatus?       @map("ad_status_to")
  userStatusFrom UserStatus?     @map("user_status_from")
  userStatusTo   UserStatus?     @map("user_status_to")
  reason         String?
  createdAt      DateTime        @default(now()) @map("created_at")

  report         AdReport        @relation(fields: [reportId], references: [id], onDelete: Cascade)
  moderator      User?           @relation("AdReportHistoryModerator", fields: [moderatorId], references: [id], onDelete: SetNull)

  @@index([reportId, createdAt])
  @@index([moderatorId, createdAt])
  @@map("ad_report_status_history")
}

model ChannelPublishLog {
  id             String               @id @default(cuid())
  adId           String               @map("ad_id")
  channelId      String?              @map("channel_id")
  channelUrl     String?              @map("channel_url")
  maxChatId      String?              @map("max_chat_id")
  maxMessageId   String?              @map("max_message_id")
  maxMessageUrl  String?              @map("max_message_url")
  status         ChannelPublishStatus @default(PENDING)
  attempt        Int                  @default(1)
  errorCode      String?              @map("error_code")
  errorMessage   String?              @map("error_message")
  payloadJson    String?              @map("payload_json")
  publishedText  String?              @map("published_text")
  mediaStrategy  String?              @map("media_strategy")
  mediaAttachmentJson String?         @map("media_attachment_json")
  removedAt      DateTime?            @map("removed_at")
  removeErrorMessage String?          @map("remove_error_message")
  scheduledAt    DateTime?            @map("scheduled_at")
  publishedAt    DateTime?            @map("published_at")
  createdAt      DateTime             @default(now()) @map("created_at")
  updatedAt      DateTime             @updatedAt @map("updated_at")

  ad             Ad                   @relation(fields: [adId], references: [id], onDelete: Cascade)

  @@index([adId, createdAt])
  @@index([status])
  @@index([channelId])
  @@index([maxChatId])
  @@index([publishedAt])
  @@map("channel_publish_logs")
}

model TelegramAccount {
  id                String                @id @default(cuid())
  userId            String?               @map("user_id")
  telegramUserId    String                @unique @map("telegram_user_id")
  username          String?
  firstName         String?               @map("first_name")
  lastName          String?               @map("last_name")
  languageCode      String?               @map("language_code")
  status            TelegramAccountStatus @default(ACTIVE)
  linkedAt          DateTime?             @map("linked_at")
  createdAt         DateTime              @default(now()) @map("created_at")
  updatedAt         DateTime              @updatedAt @map("updated_at")

  user              User?                 @relation(fields: [userId], references: [id], onDelete: SetNull)
  mediaGroupBuffers TelegramMediaGroupBuffer[]
  linkTokens        TelegramLinkToken[]

  @@index([userId])
  @@index([username])
  @@index([status])
  @@map("telegram_accounts")
}

model TelegramTarget {
  id                      String               @id @default(cuid())
  username                String               @unique
  chatId                  String?              @unique @map("chat_id")
  messageThreadId         String?              @map("message_thread_id")
  title                   String?
  type                    TelegramTargetType
  status                  TelegramTargetStatus @default(DISABLED)
  enabled                 Boolean              @default(false)
  testTarget              Boolean              @default(false) @map("test_target")
  publishEnabled          Boolean              @default(false) @map("publish_enabled")
  editEnabled             Boolean              @default(false) @map("edit_enabled")
  deleteEnabled           Boolean              @default(false) @map("delete_enabled")
  botIsMember             Boolean              @default(false) @map("bot_is_member")
  botIsAdmin              Boolean              @default(false) @map("bot_is_admin")
  canPostMessages         Boolean              @default(false) @map("can_post_messages")
  canEditMessages         Boolean              @default(false) @map("can_edit_messages")
  canDeleteMessages       Boolean              @default(false) @map("can_delete_messages")
  canSendMediaMessages    Boolean              @default(false) @map("can_send_media_messages")
  canManageTopics         Boolean              @default(false) @map("can_manage_topics")
  lastPermissionCheckAt   DateTime?            @map("last_permission_check_at")
  lastSuccessfulPublishAt DateTime?            @map("last_successful_publish_at")
  lastError               String?              @map("last_error")
  createdAt               DateTime             @default(now()) @map("created_at")
  updatedAt               DateTime             @updatedAt @map("updated_at")

  externalPublications    ExternalPublication[]

  @@index([type])
  @@index([enabled])
  @@index([testTarget])
  @@index([status])
  @@map("telegram_targets")
}

model ExternalPublication {
  id                   String                            @id @default(cuid())
  adId                 String                            @map("ad_id")
  platform             ExternalPublicationPlatform
  targetId             String?                           @map("target_id")
  publicationVersion   Int                               @default(1) @map("publication_version")
  externalChatId       String?                           @map("external_chat_id")
  externalMessageId    String?                           @map("external_message_id")
  externalMediaGroupId String?                           @map("external_media_group_id")
  externalUrl          String?                           @map("external_url")
  sourcePlatform       ExternalPublicationSourcePlatform @default(RABST24) @map("source_platform")
  correlationId        String                            @map("correlation_id")
  status               ExternalPublicationStatus         @default(PENDING)
  lastError            String?                           @map("last_error")
  publishedAt          DateTime?                         @map("published_at")
  editedAt             DateTime?                         @map("edited_at")
  deletedAt            DateTime?                         @map("deleted_at")
  createdAt            DateTime                          @default(now()) @map("created_at")
  updatedAt            DateTime                          @updatedAt @map("updated_at")

  ad                   Ad                                @relation(fields: [adId], references: [id], onDelete: Cascade)
  telegramTarget       TelegramTarget?                   @relation(fields: [targetId], references: [id], onDelete: SetNull)

  @@unique([adId, platform, targetId, publicationVersion])
  @@unique([platform, externalChatId, externalMessageId])
  @@index([adId, platform, status])
  @@index([targetId, status])
  @@index([correlationId])
  @@map("external_publications")
}

model TelegramMediaGroupBuffer {
  id              String                         @id @default(cuid())
  telegramUserId  String                         @map("telegram_user_id")
  mediaGroupId    String                         @map("media_group_id")
  payloadJson     String                         @map("payload_json")
  firstReceivedAt DateTime                       @default(now()) @map("first_received_at")
  finalizeAt      DateTime                       @map("finalize_at")
  status          TelegramMediaGroupBufferStatus @default(COLLECTING)
  createdAt       DateTime                       @default(now()) @map("created_at")
  updatedAt       DateTime                       @updatedAt @map("updated_at")

  telegramAccount TelegramAccount                @relation(fields: [telegramUserId], references: [telegramUserId], onDelete: Cascade)

  @@unique([telegramUserId, mediaGroupId])
  @@index([status, finalizeAt])
  @@map("telegram_media_group_buffers")
}

model TelegramLinkToken {
  id                String                  @id @default(cuid())
  telegramAccountId String                  @map("telegram_account_id")
  codeHash          String                  @unique @map("code_hash")
  status            TelegramLinkTokenStatus @default(PENDING)
  expiresAt         DateTime                @map("expires_at")
  consumedAt        DateTime?               @map("consumed_at")
  createdAt         DateTime                @default(now()) @map("created_at")
  updatedAt         DateTime                @updatedAt @map("updated_at")

  telegramAccount   TelegramAccount         @relation(fields: [telegramAccountId], references: [id], onDelete: Cascade)

  @@index([telegramAccountId, status])
  @@index([status, expiresAt])
  @@map("telegram_link_tokens")
}
