generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

enum UserRole {
  USER
  MODERATOR
  ADMIN
}

enum UserStatus {
  ACTIVE
  BLOCKED
  DELETED
}

enum ProfileType {
  PERSON
  COMPANY
}

enum UserTrustBadge {
  PHONE_CONFIRMED
  COMPANY_VERIFIED
  RELIABLE_EMPLOYER
  LONG_TIME_MEMBER
}

enum AdType {
  VACANCY
  RESUME
  EQUIPMENT
  MATERIAL
  TOOL
}

enum AdStatus {
  DRAFT
  PAYMENT_PENDING
  PENDING_MODERATION
  APPROVED
  REJECTED
  PUBLISHED
  HIDDEN
  ARCHIVED
  DELETED
}

enum EmploymentType {
  FULL_TIME
  PART_TIME
  CONTRACT
  SHIFT
  INTERNSHIP
  TEMPORARY
}

enum WorkFormat {
  ONSITE
  REMOTE
  HYBRID
  FIELD
}

enum SalaryPeriod {
  HOUR
  DAY
  WEEK
  MONTH
  PROJECT
}

enum EquipmentCondition {
  NEW
  USED
  REFURBISHED
}

enum ListingDealType {
  RENT
  SALE
  RENT_AND_SALE
}

enum ProductSaleType {
  RETAIL
  WHOLESALE
  BOTH
}

enum ProductCondition {
  NEW
  USED
  REFURBISHED
}

enum AdContactType {
  MAX
  PHONE
  EMAIL
  WEBSITE
  OTHER
}

enum ModerationAction {
  SUBMITTED
  APPROVED
  REJECTED
  HIDDEN
  UNPUBLISHED
  RETURNED
  ARCHIVED
  DELETED
  CHANNEL_REMOVED
  RESTORED
  AUTO_FLAGGED
  REPORT_RESOLVED
  USER_WARNED
  USER_TEMP_BLOCKED
  USER_BLOCKED
}

enum AdReportReason {
  FRAUD
  FALSE_INFORMATION
  NOT_ACTUAL
  WRONG_PRICE
  SPAM
  PROHIBITED_CONTENT
  OTHER
}

enum AdReportStatus {
  OPEN
  IN_REVIEW
  RESOLVED_ACTION_TAKEN
  RESOLVED_NO_VIOLATION
  CANCELLED
}

enum ReviewStatus {
  PENDING
  PUBLISHED
  HIDDEN
  DELETED
}

enum ChannelPublishStatus {
  PENDING
  PUBLISHED
  FAILED
  SKIPPED
  REMOVED
  REMOVE_FAILED
}

enum TelegramAccountStatus {
  ACTIVE
  BLOCKED
  DELETED
}

enum TelegramTargetType {
  CHANNEL
  GROUP
  SUPERGROUP
}

enum TelegramTargetStatus {
  READY
  NOT_ADDED
  NO_PERMISSION
  UNAVAILABLE
  DISABLED
  TESTING
  ERROR
}

enum ExternalPublicationPlatform {
  MAX
  TELEGRAM
}

enum ExternalPublicationSourcePlatform {
  RABST24
  MAX
  TELEGRAM
}

enum ExternalPublicationStatus {
  PENDING
  PUBLISHED
  EDITED
  DELETED
  FAILED
  SKIPPED
}

enum TelegramMediaGroupBufferStatus {
  COLLECTING
  FINALIZED
  FAILED
  EXPIRED
}

enum TelegramLinkTokenStatus {
  PENDING
  CONSUMED
  EXPIRED
}

enum PaymentStatus {
  PENDING
  WAITING_FOR_CAPTURE
  SUCCEEDED
  CANCELED
  REFUNDED
}

enum OutboxJobStatus {
  PENDING
  PROCESSING
  SUCCEEDED
  FAILED
  CANCELLED
}

enum JobApplicationStatus {
  NEW
  VIEWED
  CONTACTED
  SUITABLE
  REJECTED
  WITHDRAWN
}

enum NotificationDeliveryChannel {
  MAX
  IN_APP
}

enum NotificationDeliveryStatus {
  PENDING
  PROCESSING
  SUCCEEDED
  FAILED
  SKIPPED
  CANCELLED
}

enum SavedSearchFrequency {
  IMMEDIATE
  DAILY
  OFF
}

enum PromotionProductType {
  BUMP_ONCE
  URGENT_BADGE
  PIN_CATEGORY
  HIGHLIGHT_CARD
  RECOMMENDED
  AUTO_BUMP
}

enum VacancyPublicationGrantSource {
  REFERRAL
}

enum VacancyPublicationUsageSource {
  PACKAGE
  BONUS
  MIXED
}

enum VerifiedContactType {
  PHONE
  MAX_ACCOUNT
}

enum ContactSource {
  MAX_MINI_APP
  MAX_BOT
  SMS_OTP
  ADMIN_VERIFIED
  UNVERIFIED_LEGACY
}

enum ContactStatus {
  PENDING
  VERIFIED
  EXPIRED
  REVOKED
  DISPUTED
}

enum ContactAccessMode {
  MAX_VERIFIED_CONNECTION
  VERIFIED_PHONE_UNLOCK
}

enum ContactAccessStatus {
  PENDING_PAYMENT
  ACTIVE
  REVOKED
  REFUNDED
  DISPUTED
}

enum ContactDisputeReason {
  NUMBER_DOES_NOT_EXIST
  WRONG_PERSON
  UNABLE_TO_CONNECT
  CONTACT_DIFFERS
  SUSPICIOUS_BEHAVIOR
  OTHER
}

enum ContactDisputeStatus {
  OPEN
  AWAITING_REVERIFICATION
  UNDER_REVIEW
  RESOLVED_VALID_CONTACT
  RESOLVED_REFUND
  REJECTED_ABUSE
}

model User {
  id              String   @id @default(cuid())
  maxUserId       String   @unique @map("max_user_id")
  maxUsername     String?  @map("max_username")
  firstName       String?  @map("first_name")
  lastName        String?  @map("last_name")
  displayName     String?  @map("display_name")
  locale          String?
  role            UserRole @default(USER)
  status          UserStatus @default(ACTIVE)
  blockedUntil    DateTime? @map("blocked_until")
  startedAt       DateTime? @map("started_at")
  lastSeenAt      DateTime? @map("last_seen_at")
  deletedAt       DateTime? @map("deleted_at")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  profile         UserProfile?
  ads             Ad[]
  adRevisions     AdRevision[]
  favorites       Favorite[]
  reviewsWritten  Review[] @relation("ReviewAuthor")
  reviewsReceived Review[] @relation("ReviewSubject")
  moderationLogs  ModerationLog[] @relation("ModerationLogModerator")
  referralsMade   Referral[] @relation("ReferralReferrer")
  referralReceived Referral? @relation("ReferralReferred")
  vacancyPublicationGrants VacancyPublicationGrant[]
  vacancyPublicationBalance UserVacancyPublicationBalance?
  vacancyPublicationUsages VacancyPublicationUsage[]
  telegramAccounts TelegramAccount[]
  resumeContactUnlocks ResumeContactUnlock[] @relation("ResumeContactUnlockBuyer")
  verifiedContacts VerifiedContact[]
  contactDisclosureConsents ContactDisclosureConsent[]
  contactAccessEntitlements ContactAccessEntitlement[] @relation("ContactAccessBuyer")
  contactDisputesOpened ContactDispute[] @relation("ContactDisputeBuyer")
  contactDisputesReceived ContactDispute[] @relation("ContactDisputeAuthor")
  contactDisputesResolved ContactDispute[] @relation("ContactDisputeResolver")
  jobApplications JobApplication[] @relation("JobApplicationApplicant")
  notifications   Notification[]
  notificationPreference NotificationPreference?
  savedSearches   SavedSearch[]
  promotionProductsUpdated PromotionProduct[] @relation("PromotionProductUpdatedBy")
  promotionPurchases PromotionPurchase[]
  adReportsMade   AdReport[] @relation("AdReportReporter")
  adReportsReceived AdReport[] @relation("AdReportReportedUser")
  adReportsModerated AdReport[] @relation("AdReportModerator")
  adReportHistory AdReportStatusHistory[] @relation("AdReportHistoryModerator")
  trustBadgeAssignments UserTrustBadgeAssignment[] @relation("UserTrustBadgeUser")
  trustBadgesAssigned UserTrustBadgeAssignment[] @relation("UserTrustBadgeAssignedBy")
  trustBadgeHistory UserTrustBadgeHistory[] @relation("UserTrustBadgeHistoryUser")
  trustBadgeHistoryModerated UserTrustBadgeHistory[] @relation("UserTrustBadgeHistoryModerator")

  @@index([status])
  @@index([role])
  @@index([maxUsername])
  @@index([lastSeenAt])
  @@index([deletedAt])
  @@map("users")
}

model Referral {
  id          String    @id @default(cuid())
  referrerId  String    @map("referrer_id")
  referredId  String    @unique @map("referred_id")
  rewardedAt  DateTime? @map("rewarded_at")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  referrer    User      @relation("ReferralReferrer", fields: [referrerId], references: [id], onDelete: Cascade)
  referred    User      @relation("ReferralReferred", fields: [referredId], references: [id], onDelete: Cascade)
  grant       VacancyPublicationGrant?

  @@index([referrerId, createdAt])
  @@index([rewardedAt])
  @@map("referrals")
}

model VacancyPublicationGrant {
  id                String                         @id @default(cuid())
  userId            String                         @map("user_id")
  source            VacancyPublicationGrantSource  @default(REFERRAL)
  sourceReferralId  String?                        @unique @map("source_referral_id")
  publications      Int                            @default(1)
  createdAt         DateTime                       @default(now()) @map("created_at")

  user              User                           @relation(fields: [userId], references: [id], onDelete: Cascade)
  sourceReferral    Referral?                      @relation(fields: [sourceReferralId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([source])
  @@map("vacancy_publication_grants")
}

model UserVacancyPublicationBalance {
  userId       String   @id @map("user_id")
  purchased    Int      @default(0)
  bonus        Int      @default(0)
  used         Int      @default(0)
  remaining    Int      @default(0)
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_vacancy_publication_balances")
}

model VacancyPublicationUsage {
  id          String                         @id @default(cuid())
  userId      String                         @map("user_id")
  adId        String                         @map("ad_id")
  source      VacancyPublicationUsageSource  @default(PACKAGE)
  returnedAt  DateTime?                      @map("returned_at")
  createdAt   DateTime                       @default(now()) @map("created_at")
  updatedAt   DateTime                       @updatedAt @map("updated_at")

  user        User                           @relation(fields: [userId], references: [id], onDelete: Cascade)
  ad          Ad                             @relation(fields: [adId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([userId, returnedAt])
  @@index([adId, createdAt])
  @@map("vacancy_publication_usages")
}

model UserProfile {
  id                         String      @id @default(cuid())
  userId                     String      @unique @map("user_id")
  profileType                ProfileType @default(PERSON) @map("profile_type")
  companyName                String?     @map("company_name")
  city                       String?
  districtText               String?     @map("district_text")
  about                      String?
  avatarUrl                  String?     @map("avatar_url")
  phone                      String?
  email                      String?
  website                    String?
  maxContact                 String?     @map("max_contact")
  specialization             String?
  experience                 String?
  companyInfo                String?     @map("company_info")
  registrationDetails        String?     @map("registration_details")
  showPhone                  Boolean     @default(false) @map("show_phone")
  showEmail                  Boolean     @default(false) @map("show_email")
  showWebsite                Boolean     @default(true) @map("show_website")
  showMaxContact             Boolean     @default(true) @map("show_max_contact")
  allowResumePublicProfile   Boolean     @default(true) @map("allow_resume_public_profile")
  deletedAt                  DateTime?   @map("deleted_at")
  createdAt                  DateTime    @default(now()) @map("created_at")
  updatedAt                  DateTime    @updatedAt @map("updated_at")

  user                       User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([city])
  @@index([districtText])
  @@index([profileType])
  @@index([deletedAt])
  @@map("user_profiles")
}

model UserTrustBadgeAssignment {
  userId       String         @map("user_id")
  badge        UserTrustBadge
  assignedById String?        @map("assigned_by_id")
  reason       String?
  createdAt    DateTime       @default(now()) @map("created_at")
  updatedAt    DateTime       @updatedAt @map("updated_at")

  user         User           @relation("UserTrustBadgeUser", fields: [userId], references: [id], onDelete: Cascade)
  assignedBy   User?          @relation("UserTrustBadgeAssignedBy", fields: [assignedById], references: [id], onDelete: SetNull)

  @@id([userId, badge])
  @@index([badge])
  @@index([assignedById])
  @@map("user_trust_badge_assignments")
}

model UserTrustBadgeHistory {
  id          String         @id @default(cuid())
  userId      String         @map("user_id")
  badge       UserTrustBadge
  action      String
  moderatorId String?        @map("moderator_id")
  reason      String?
  createdAt   DateTime       @default(now()) @map("created_at")

  user        User           @relation("UserTrustBadgeHistoryUser", fields: [userId], references: [id], onDelete: Cascade)
  moderator   User?          @relation("UserTrustBadgeHistoryModerator", fields: [moderatorId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([badge, createdAt])
  @@index([moderatorId, createdAt])
  @@map("user_trust_badge_history")
}

model Ad {
  id                 String    @id @default(cuid())
  ownerId            String    @map("owner_id")
  type               AdType
  status             AdStatus  @default(PENDING_MODERATION)
  title              String
  description        String?
  city               String?
  districtText       String?   @map("district_text")
  categoryText       String?   @map("category_text")
  locationLat        Float?    @map("location_lat")
  locationLon        Float?    @map("location_lon")
  priceAmount        Float?    @map("price_amount")
  currency           String    @default("RUB")
  metadataJson       String?   @map("metadata_json")
  isTest             Boolean   @default(false) @map("is_test")
  moderatedAt        DateTime? @map("moderated_at")
  publishedAt        DateTime? @map("published_at")
  hiddenAt           DateTime? @map("hidden_at")
  archivedAt         DateTime? @map("archived_at")
  expiresAt          DateTime? @map("expires_at")
  deletedAt          DateTime? @map("deleted_at")
  createdAt          DateTime  @default(now()) @map("created_at")
  updatedAt          DateTime  @updatedAt @map("updated_at")

  owner              User      @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  vacancyDetails     VacancyDetails?
  resumeDetails      ResumeDetails?
  equipmentDetails   EquipmentDetails?
  productDetails     ProductDetails?
  photos             AdPhoto[]
  contacts           AdContact[]
  requirements       AdRequirement[]
  responsibilities   AdResponsibility[]
  benefits           AdBenefit[]
  favorites          Favorite[]
  reviews            Review[]
  payments           AdPayment[]
  resumeContactUnlocks ResumeContactUnlock[] @relation("ResumeContactUnlockResume")
  contactAccessEntitlements ContactAccessEntitlement[]
  contactDisputes ContactDispute[]
  vacancyApplications JobApplication[] @relation("JobApplicationVacancy")
  resumeApplications JobApplication[] @relation("JobApplicationResume")
  vacancyPublicationUsages VacancyPublicationUsage[]
  revisions          AdRevision[]
  moderationLogs     ModerationLog[]
  channelPublishLogs ChannelPublishLog[]
  externalPublications ExternalPublication[]
  savedSearchMatches SavedSearchMatch[]
  promotionPurchases PromotionPurchase[]
  metricDaily       AdMetricDaily[]
  metricUniqueViews AdMetricUniqueView[]
  reports           AdReport[]
  boostedAt          DateTime? @map("boosted_at")
  promotionUrgentUntil DateTime? @map("promotion_urgent_until")
  promotionPinnedUntil DateTime? @map("promotion_pinned_until")
  promotionHighlightedUntil DateTime? @map("promotion_highlighted_until")
  promotionRecommendedUntil DateTime? @map("promotion_recommended_until")

  @@index([ownerId])
  @@index([ownerId, status, updatedAt])
  @@index([type, status])
  @@index([type, status, publishedAt])
  @@index([status, moderatedAt])
  @@index([city])
  @@index([districtText])
  @@index([categoryText])
  @@index([isTest])
  @@index([publishedAt])
  @@index([promotionPinnedUntil])
  @@index([promotionRecommendedUntil])
  @@index([promotionUrgentUntil])
  @@index([boostedAt])
  @@index([deletedAt])
  @@map("ads")
}

model AdRevision {
  id              String   @id @default(cuid())
  adId            String   @map("ad_id")
  version         Int
  status          String   @default("DRAFT")
  dataJson        String   @map("data_json")
  mediaJson       String?  @map("media_json")
  createdBy       String   @map("created_by")
  paymentId       String?  @unique @map("payment_id")
  submittedAt     DateTime? @map("submitted_at")
  approvedAt      DateTime? @map("approved_at")
  rejectedAt      DateTime? @map("rejected_at")
  rejectionReason String?  @map("rejection_reason")
  cancelledAt     DateTime? @map("cancelled_at")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  ad              Ad       @relation(fields: [adId], references: [id], onDelete: Cascade)
  creator         User     @relation(fields: [createdBy], references: [id], onDelete: Cascade)

  @@unique([adId, version])
  @@index([adId, status, createdAt])
  @@index([createdBy, status, createdAt])
  @@index([paymentId])
  @@map("ad_revisions")
}

model VacancyDetails {
  id                  String          @id @default(cuid())
  adId                String          @unique @map("ad_id")
  companyName         String?         @map("company_name")
  position            String?
  employmentType      EmploymentType? @map("employment_type")
  workFormat          WorkFormat?     @map("work_format")
  salaryFrom          Float?          @map("salary_from")
  salaryTo            Float?          @map("salary_to")
  salaryCurrency      String          @default("RUB") @map("salary_currency")
  salaryPeriod        SalaryPeriod?   @map("salary_period")
  isSalaryNegotiable  Boolean         @default(false) @map("is_salary_negotiable")
  schedule            String?
  experience          String?
  education           String?
  paymentFormat       String?         @map("payment_format")
  providesAccommodation Boolean        @default(false) @map("provides_accommodation")
  providesMeals       Boolean         @default(false) @map("provides_meals")
  projectDuration     String?         @map("project_duration")
  createdAt           DateTime        @default(now()) @map("created_at")
  updatedAt           DateTime        @updatedAt @map("updated_at")

  ad                  Ad              @relation(fields: [adId], references: [id], onDelete: Cascade)
  metroStations       VacancyMetroStation[]

  @@index([employmentType])
  @@index([workFormat])
  @@index([salaryFrom])
  @@map("vacancy_details")
}

model ResumeDetails {
  id               String          @id @default(cuid())
  adId             String          @unique @map("ad_id")
  desiredPosition  String?         @map("desired_position")
  profession       String?
  specialization   String?
  experienceYears  Int?            @map("experience_years")
  experienceText   String?         @map("experience_text")
  employmentType   EmploymentType? @map("employment_type")
  workFormat       WorkFormat?     @map("work_format")
  desiredSchedule  String?         @map("desired_schedule")
  expectedSalary   Float?          @map("expected_salary")
  salaryCurrency   String          @default("RUB") @map("salary_currency")
  skillsJson       String?         @map("skills_json")
  education        String?
  availability     String?
  travelReady      Boolean         @default(false) @map("travel_ready")
  siteAccommodationReady Boolean   @default(false) @map("site_accommodation_ready")
  portfolioUrl     String?         @map("portfolio_url")
  verifiedContactId String?        @map("verified_contact_id")
  contactConsentId  String?        @map("contact_consent_id")
  contactAvailabilityStatus String @default("UNVERIFIED_LEGACY") @map("contact_availability_status")
  createdAt        DateTime        @default(now()) @map("created_at")
  updatedAt        DateTime        @updatedAt @map("updated_at")

  ad               Ad              @relation(fields: [adId], references: [id], onDelete: Cascade)
  verifiedContact  VerifiedContact? @relation(fields: [verifiedContactId], references: [id], onDelete: SetNull)
  contactConsent   ContactDisclosureConsent? @relation(fields: [contactConsentId], references: [id], onDelete: SetNull)

  @@index([desiredPosition])
  @@index([experienceYears])
  @@index([employmentType])
  @@index([workFormat])
  @@index([verifiedContactId])
  @@index([contactConsentId])
  @@index([contactAvailabilityStatus])
  @@map("resume_details")
}

model EquipmentDetails {
  id              String             @id @default(cuid())
  adId            String             @unique @map("ad_id")
  categoryText    String?            @map("category_text")
  dealType        ListingDealType?   @map("deal_type")
  condition       EquipmentCondition?
  brand           String?
  model           String?
  productionYear  Int?               @map("production_year")
  hourlyPrice     Float?             @map("hourly_price")
  shiftPrice      Float?             @map("shift_price")
  dailyPrice      Float?             @map("daily_price")
  rentalPrice     Float?             @map("rental_price")
  salePrice       Float?             @map("sale_price")
  depositAmount   Float?             @map("deposit_amount")
  currency        String             @default("RUB")
  operatorIncluded Boolean            @default(false) @map("operator_included")
  deliveryAvailable Boolean           @default(false) @map("delivery_available")
  availability    String?
  createdAt       DateTime           @default(now()) @map("created_at")
  updatedAt       DateTime           @updatedAt @map("updated_at")

  ad              Ad                 @relation(fields: [adId], references: [id], onDelete: Cascade)

  @@index([categoryText])
  @@index([condition])
  @@index([brand])
  @@index([model])
  @@map("equipment_details")
}

model ProductDetails {
  id                String            @id @default(cuid())
  adId              String            @unique @map("ad_id")
  manufacturer      String?
  model             String?
  condition         ProductCondition?
  quantity          Float?
  unit              String?
  saleType          ProductSaleType?  @map("sale_type")
  deliveryAvailable Boolean           @default(false) @map("delivery_available")
  createdAt         DateTime          @default(now()) @map("created_at")
  updatedAt         DateTime          @updatedAt @map("updated_at")

  ad                Ad                @relation(fields: [adId], references: [id], onDelete: Cascade)

  @@index([manufacturer])
  @@index([model])
  @@index([condition])
  @@index([saleType])
  @@map("product_details")
}

model AdPhoto {
  id          String    @id @default(cuid())
  adId        String    @map("ad_id")
  storageKey  String    @unique @map("storage_key")
  url         String
  previewUrl  String?   @map("preview_url")
  mimeType    String?   @map("mime_type")
  sizeBytes   Int?      @map("size_bytes")
  width       Int?
  height      Int?
  maxMediaToken String?   @map("max_media_token")
  maxMediaType  String?   @map("max_media_type")
  maxMediaStrategy String? @map("max_media_strategy")
  maxMediaPayloadJson String? @map("max_media_payload_json")
  maxMediaUploadedAt DateTime? @map("max_media_uploaded_at")
  sortOrder   Int       @default(0) @map("sort_order")
  altText     String?   @map("alt_text")
  deletedAt   DateTime? @map("deleted_at")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  ad          Ad        @relation(fields: [adId], references: [id], onDelete: Cascade)

  @@index([adId, sortOrder])
  @@index([maxMediaToken])
  @@index([deletedAt])
  @@map("ad_photos")
}

model AdContact {
  id          String        @id @default(cuid())
  adId        String        @map("ad_id")
  type        AdContactType
  label       String?
  value       String
  isPreferred Boolean       @default(false) @map("is_preferred")
  isPublic    Boolean       @default(true) @map("is_public")
  sortOrder   Int           @default(0) @map("sort_order")
  deletedAt   DateTime?     @map("deleted_at")
  createdAt   DateTime      @default(now()) @map("created_at")
  updatedAt   DateTime      @updatedAt @map("updated_at")

  ad          Ad            @relation(fields: [adId], references: [id], onDelete: Cascade)

  @@index([adId, sortOrder])
  @@index([adId, type])
  @@index([deletedAt])
  @@map("ad_contacts")
}

model MetroStation {
  id           String    @id @default(cuid())
  city         String
  name         String
  lineName     String?   @map("line_name")
  lineColor    String?   @map("line_color")
  externalCode String?   @map("external_code")
  isActive     Boolean   @default(true) @map("is_active")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  vacancies    VacancyMetroStation[]

  @@unique([city, name, lineName])
  @@index([city])
  @@index([isActive])
  @@map("metro_stations")
}

model VacancyMetroStation {
